# Token de https://padelapi.org (plan gratuito: 50.000 req/mes)
# Sin este token el sitio usa el snapshot FIP de respaldo y se sigue viendo completo.
PADEL_API_TOKEN=

# Opcional: ID numérico del jugador en Padel API (si no está, se busca por nombre)
PADEL_PLAYER_ID=

# URL pública del sitio (Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
